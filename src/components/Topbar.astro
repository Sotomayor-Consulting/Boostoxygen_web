---
import { site } from "../lib/site";
import { withBase } from "../lib/paths";
import IconAlt from "./Icon.astro";
import { Icon } from "astro-icon/components";
// The link for the current page is white, the rest sit at 60% (Framer current-page link style).
// Pages pass their own path ("/", "/404", "/projects/<slug>"), without the trailing slash.
interface Props {
  path: string;
}
const { path } = Astro.props;
const isCurrent = (href: string) => href === withBase(path);
---

<header class="topbar" data-topbar>
  <div class="topbar-bar container">
    <div class="topbar-logo">
      <a href={withBase("/")} class="body" style="color: var(--white)"
        ><Icon name="BoostOxygenEC-flag-print-03" class="Logo-header" /></a
      >
    </div>
    <nav class="topbar-links" aria-label="Primary">
      {
        site.nav.map((l) => (
          <a
            class:list={["body-sb", { "is-current": isCurrent(l.href) }]}
            href={l.href}
            aria-current={isCurrent(l.href) ? "page" : undefined}
          >
            {l.label}
          </a>
        ))
      }
    </nav>
    <button
      type="button"
      class="topbar-menu"
      aria-label="Open menu"
      aria-expanded="false"
      data-menu-btn
    >
      <span class="topbar-icon" data-icon-open
        ><IconAlt name="menu" size={24} stroke={1} /></span
      >
      <span class="topbar-icon" data-icon-close style="opacity: 0"
        ><IconAlt name="x" size={24} stroke={1} /></span
      >
    </button>
  </div>
  <nav
    class="topbar-mobile"
    aria-label="Mobile"
    aria-hidden="true"
    data-mobile-nav
  >
    {
      site.nav.map((l) => (
        <a
          class:list={["h3", { "is-current": isCurrent(l.href) }]}
          href={l.href}
          tabindex="-1"
        >
          {l.label}
        </a>
      ))
    }
  </nav>
</header>

