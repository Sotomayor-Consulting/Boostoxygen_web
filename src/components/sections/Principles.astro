---
import { site } from "../../lib/site";
import { Icon } from 'astro-icon/components'
import ScrollWords from "../ScrollWords.astro";

const icons: Record<string, string> = {
  target: '<path fill="currentColor" fill-rule="evenodd" d="M17 6h2V4h-6v2h2v2h-2.17a3.001 3.001 0 1 0 0 2H15v2.083A6 6 0 0 0 10 18v25a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V18a6 6 0 0 0-5-5.917V10h5V8h-5zm-1 8a4 4 0 0 0-4 4v2h8v-2a4 4 0 0 0-4-4m-4 28V22h8v20zM9 9a1 1 0 1 1 2 0a1 1 0 0 1-2 0m17 12a4 4 0 0 1 8 0v6a4 4 0 0 1-8 0zm4-2a2 2 0 0 0-2 2v6a2 2 0 1 0 4 0v-6a2 2 0 0 0-2-2m8 7h-3v-2h3a3 3 0 1 1 0 6a1 1 0 0 0-1 1v1h4v2h-5a1 1 0 0 1-1-1v-2a3 3 0 0 1 3-3a1 1 0 1 0 0-2" clip-rule="evenodd"/>',
  sparkles:
    '<path d="M9.94 14.06A2 2 0 0 0 8.5 12.62L2.37 11.04a.5.5 0 0 1 0-.97L8.5 8.5a2 2 0 0 0 1.44-1.44l1.58-6.13a.5.5 0 0 1 .96 0L14.06 7.06A2 2 0 0 0 15.5 8.5l6.13 1.58a.5.5 0 0 1 0 .96L15.5 12.62a2 2 0 0 0-1.44 1.44l-1.58 6.13a.5.5 0 0 1-.96 0z" /><path d="M20 3v4" /><path d="M22 5h-4" /><path d="M4 17v2" /><path d="M5 18H3" />',
  accessibility:
    '<circle cx="16" cy="4" r="1" /><path d="m18 19 1-7-5.87.94" /><path d="m5 8 3-3 5.5 3-2.21 3.1" /><path d="M4.24 14.48a5 5 0 0 0 6.88 6.05" /><path d="M13.76 17.52a5 5 0 0 0-3.88-6.9" />',
  smile: '<circle cx="12" cy="12" r="10" /><path d="M8 14s1.5 2 4 2 4-2 4-2" /><line x1="9" x2="9.01" y1="9" y2="9" /><line x1="15" x2="15.01" y1="9" y2="9" />',
  compass: '<circle cx="12" cy="12" r="10" /><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76" />',
};
---
<section class="principles container">
  <div class="principles-header">
    <ScrollWords as="h2" class="h2 balance principles-heading" text={`${site.principles.length} razones para elegir Boost Oxygen`} />
  </div>
  <div class="principles-cards">
    {site.principles.map((c) => (
      <div class="pcard" data-pcard>
        <div class="pcard-inner">
          <div class="pcard-face pcard-front">
            <h3>{c.title}</h3>
            {/* <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.2)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[c.icon] ?? icons.target} /> */}
            <Icon name={c.icon} aria-hidden="true"/>
          </div>
          <div class="pcard-face pcard-back">
            <img src={c.image} alt={c.alt} loading="lazy" />
            <p>{c.description}</p>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  [data-icon]{
    font-size: 32px;
    stroke-width: 2;
  }
</style>