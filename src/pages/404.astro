---
import Base from "../layouts/Base.astro";
import Topbar from "../components/Topbar.astro";
import Footer from "../components/sections/Footer.astro";
import ScrollRing from "../components/ScrollRing.astro";
import Icon from "../components/Icon.astro";
import { site } from "../lib/site";
---
<Base title={`Página no encontrada | ${site.name}`}>
  <Topbar path="/404" />
  <main>
    <section class="nf-hero">
      <ScrollRing images={site.ring} radius={360} scrollSpeed={0.02} autoSpin={2} />
      <div class="nf-content">
        <h1 class="h1">Página no encontrada</h1>
        <p class="body muted balance nf-text">La página que buscas no existe o cambió de lugar. Volvamos al inicio para que sigas explorando.</p>
        <a class="btn" href="/"><span class="body-sb">Volver al inicio</span><Icon name="arrow-up-right" size={20} /></a>
      </div>
    </section>
  </main>
  <Footer />
</Base>
